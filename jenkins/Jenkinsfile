// Jenkins Declarative Pipeline for the Blue-Green Student Portal.
//
// This pipeline deliberately does NOT require Python/pip/pytest to be
// installed on the Jenkins host. It tests inside the same Docker image
// that gets deployed (pytest is already in backend/requirements.txt), so
// it works whether Jenkins runs on Windows, Mac, Linux, or in a container -
// as long as the Docker CLI is on Jenkins' PATH.
//
// Prerequisite: the main stack should already be running once via
// `docker compose up -d` from the project root, so db/redis/nginx exist
// for this pipeline to deploy the idle color into.
//
// Setup (one-time):
//   1. Create a Pipeline job pointing "Pipeline script from SCM" at your
//      GitHub repo, script path: jenkins/Jenkinsfile
//   2. (Optional, for real remote deploys) add Docker Hub credentials in
//      Jenkins as "dockerhub-creds" and re-enable the Push stage below.
//
pipeline {
    agent any

    environment {
        // Jenkins checks the repo out into its own workspace folder, whose
        // name differs from your manual "blue-green-system" folder. Docker
        // Compose names its project after that folder by default, which
        // would spin up a SECOND, separate stack (and fight over the same
        // host ports like 5432/8080). Pinning the project name here makes
        // every `docker compose` command in this pipeline operate on the
        // exact same containers you started by hand with
        // `docker compose up -d`, instead of creating duplicates.
        COMPOSE_PROJECT_NAME = "blue-green-system"
        TARGET_COLOR = "green" // pipeline always deploys to the idle color
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Images') {
            steps {
                sh 'docker compose build backend-blue backend-green'
            }
        }

        stage('Run Tests') {
            steps {
                // tests/ is now baked into the image at build time (see
                // backend/Dockerfile), so no volume mount needed here -
                // avoids Windows/Git-Bash path translation issues.
                sh 'docker compose run --rm backend-blue pytest tests -v'
            }
        }

        stage('Deploy to Idle Color') {
            steps {
                sh "docker compose up -d backend-${TARGET_COLOR}"
            }
        }

        stage('Health Check') {
            steps {
                sh "sleep 5 && docker compose exec -T backend-${TARGET_COLOR} curl -sf http://localhost:5000/health"
            }
        }

        stage('Switch Traffic') {
            steps {
                sh "bash scripts/switch.sh ${TARGET_COLOR}"
            }
        }
    }

    post {
        success {
            echo "Deployment successful. Traffic now on ${TARGET_COLOR}."
        }
        failure {
            echo "Pipeline failed - traffic was NOT switched. Investigate before retrying."
        }
    }
}
